# Resend API キー（https://resend.com で取得）
# ※ Vercel では変数名を RESEND_API_KEY にしてください（RESEND_API_EMAIL では不可）
RESEND_API_KEY=re_xxxxxxxx

# お問い合わせの通知先（省略時: choco6taito3@gmail.com）
CONTACT_TO_EMAIL=choco6taito3@gmail.com

# 送信元メールアドレス
# テスト時: Portfolio <onboarding@resend.dev>（Resend 登録メール宛のみ送信可）
# 本番時: ドメイン認証後に Portfolio <noreply@yourdomain.com> などを設定
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
